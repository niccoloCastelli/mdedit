<w:p w14:paraId="0000000a"><w:pPr><w:rPr /><w:pStyle w:val="BodyText" /></w:pPr><w:r><w:rPr /><w:t xml:space="preserve">A step-by-step guide for operators turning a customer&apos;s stablecoins into a</w:t></w:r><w:r><w:rPr /><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr /><w:t xml:space="preserve">bank payment. It covers opening a wallet, receiving funds, checking the</w:t></w:r><w:r><w:rPr /><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr /><w:t xml:space="preserve">balance, and paying a beneficiary.</w:t></w:r></w:p>
