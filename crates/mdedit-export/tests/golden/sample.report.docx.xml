<w:p w14:paraId="0000000c"><w:pPr><w:rPr /><w:pStyle w:val="BodyText" /></w:pPr><w:r><w:rPr /><w:t xml:space="preserve">An off-ramp takes </w:t></w:r><w:r><w:rPr><w:b /><w:bCs /></w:rPr><w:t xml:space="preserve">four steps</w:t></w:r><w:r><w:rPr><w:rStyle w:val="FootnoteReference" /></w:rPr><w:footnoteReference w:id="1" /></w:r><w:r><w:rPr /><w:t xml:space="preserve">: open a managed wallet, send stablecoins to</w:t></w:r><w:r><w:rPr /><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr /><w:t xml:space="preserve">it, check the balance, then pay out. The partner holds the wallet and</w:t></w:r><w:r><w:rPr /><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr /><w:t xml:space="preserve">converts the stablecoins to </w:t></w:r><w:r><w:rPr><w:i /><w:iCs /></w:rPr><w:t xml:space="preserve">fiat</w:t></w:r><w:r><w:rPr /><w:t xml:space="preserve"> when the payout leaves.</w:t></w:r><w:r><w:rPr><w:rStyle w:val="FootnoteReference" /></w:rPr><w:footnoteReference w:id="2" /></w:r></w:p>
